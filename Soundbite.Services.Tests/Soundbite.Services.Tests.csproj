<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<Configurations>Debug;Release;DebugWithCodeGen;DebugNoSecurity</Configurations>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Content\30-sec-music-mpg-vbr.mpg" />
		<None Remove="Content\37-sec-cbr.mp3" />
		<None Remove="Content\37-sec-vbr.mp3" />
		<None Remove="Content\three-seconds-cbr.mp3" />
		<None Remove="Content\Transcript.mp3" />
		<None Remove="Content\two-min-five-mb-cbr.mp3" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Content\30-sec-music-mpg-vbr.mpg" />
		<EmbeddedResource Include="Content\37-sec-cbr.mp3" />
		<EmbeddedResource Include="Content\37-sec-vbr.mp3" />
		<EmbeddedResource Include="Content\three-seconds-cbr.mp3" />
		<EmbeddedResource Include="Content\Transcript.mp3" />
		<EmbeddedResource Include="Content\two-min-five-mb-cbr.mp3" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.7.1" />
		<PackageReference Include="coverlet.collector" Version="1.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Moq" Version="4.17.2" />
		<PackageReference Include="Shouldly" Version="3.0.2" />
		<PackageReference Include="xunit" Version="2.4.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Masticore.Entity.Tests\Masticore.Entity.Tests.csproj" />
		<ProjectReference Include="..\Masticore.Entity\Masticore.Entity.csproj" />
		<ProjectReference Include="..\Masticore.Mail\Masticore.Mail.csproj" />
		<ProjectReference Include="..\Masticore.Services.Tests\Masticore.Services.Tests.csproj" />
		<ProjectReference Include="..\Masticore.Services\Masticore.Services.csproj" />
		<ProjectReference Include="..\Masticore.Transcription.Azure\Masticore.Transcription.Azure.csproj" />
		<ProjectReference Include="..\Masticore.Transcription\Masticore.Transcription.csproj" />
		<ProjectReference Include="..\Masticore\Masticore.csproj" />
		<ProjectReference Include="..\Soundbite.Entity.Tests\Soundbite.Entity.Tests.csproj" />
		<ProjectReference Include="..\Soundbite.Entity\Soundbite.Entity.csproj" />
		<ProjectReference Include="..\Soundbite.Mail\Soundbite.Messaging.csproj" />
		<ProjectReference Include="..\Soundbite\Soundbite.csproj" />
		<ProjectReference Include="..\Soundbite.Services\Soundbite.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Media\Content\" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Example\V1\1080p\playlist.m3u8">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Example\V1\playlist.m3u8">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
