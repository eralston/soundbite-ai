{
  "name": "@soundbite/spa",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@azure/msal-browser": "2.0.2",
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@microsoft/applicationinsights-web": "^2.5.11",
    "@okta/okta-auth-js": "6.7.4",
    "@soundbite/api": "^1.0.0",
    "@soundbite/api-axios": "^1.0.0",
    "@soundbite/widgets-react": "^1.0.0",
    "axios": "^0.21.1",
    "bootstrap": "^4.5.0",
    "chart.js": "^2.9.4",
    "classnames": "^2.2.6",
    "merge": "^1.2.1",
    "mic-recorder-to-mp3": "^2.2.2",
    "mobx": "^6.3.2",
    "mobx-react-lite": "^3.2.0",
    "moment": "^2.29.1",
    "oidc-client": "^1.9.0",
    "query-string": "^7.1.1",
    "quill": "^1.3.7",
    "react": "^17.0.1",
    "react-chartjs-2": "^2.11.1",
    "react-datetime": "^2.16.3",
    "react-dom": "^17.0.1",
    "react-progress-button": "^5.1.0",
    "react-router-bootstrap": "^0.25.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^4.0.3",
    "react-scrubber": "^2.0.0",
    "react-select": "^3.1.0",
    "reactstrap": "^8.9.0",
    "sanitize-html": "^2.3.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",    
    "@testing-library/jest-dom": "^5.11.10",
    "@testing-library/react": "^10.4.8",
    "@testing-library/user-event": "^12.1.1",
    "@types/chart.js": "^2.9.31",
    "@types/classnames": "^2.2.11",
    "@types/enzyme": "^3.10.5",
    "@types/jest": "^26.0.22",
    "@types/node": "^14.0.11",
    "@types/react": "^17.0.45",
    "@types/react-dom": "^17.0.17",
    "@types/react-router": "^5.1.7",
    "@types/react-router-dom": "^5.1.7",
    "@types/react-select": "^3.0.13",
    "@types/reactstrap": "^8.7.2",
    "@types/sanitize-html": "^1.27.2",
    "ajv": "^6.9.1",
    "cross-env": "^5.2.0",
    "eslint": "^6.8.0",
    "eslint-config-react-app": "^5.2.0",
    "eslint-plugin-flowtype": "^4.6.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.18.3",
    "http-proxy-middleware": "2.0.6",
    "husky": "^4.2.5",
    "jest": "26.6.0",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^2.0.5",
    "rimraf": "^3.0.2",
    "ts-jest": "^26.5.4",
    "typescript": "^4.7.4"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "scripts": {
    "build": "npm run prebuild && react-scripts --openssl-legacy-provider build",
    "clean": "rimraf ./build",
    "format": "prettier --write src/**/*.{ts,tsx,scss,css,json} && eslint --fix --ext .js,.jsx,.ts,.tsx src",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src --color",
    "prebuild": "node ./spa-prebuild.js",
    "ready": "npm run format && npm run build",
    "start": "set \"FAST_REFRESH=false\" &&set \"REACT_APP_CONFIG_API_PREFIX=https://localhost:44390\" &&npm run clean && set HTTPS=true&&react-scripts --openssl-legacy-provider start",
    "start:ngrok": "set \"REACT_APP_CONFIG_API_PREFIX=https://api.soundbite.ai.ngrok.io\" && npm run clean && react-scripts --openssl-legacy-provider start",
    "test": "echo \"Tests Disabled\" && exit 0",
    "test:coverage": "react-scripts test --coverage --runInBand --watchAll=false",
    "test:react-scripts": "cross-env CI=true react-scripts test --env=jsdom",
    "test:snapshot": "react-scripts test -u --watchAll=false"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx",
      "!src/serviceWorker.ts"
    ],
    "coveragePathIgnorePatterns": [
      "./src/*/*.types.{ts,tsx}",
      "./src/index.tsx",
      "./src/serviceWorker.ts"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text-summary",
      "clover"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 70,
        "lines": 70,
        "functions": 70
      }
    },
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/ts-jest"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!mic-recorder).+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy",
      "src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
