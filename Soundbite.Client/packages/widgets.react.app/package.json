    "@types/react-dom": "^17.0.17",
    "@types/react-router-dom": "^5.1.7",
    "@types/sanitize-html": "^1.27.2",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.7.4"
