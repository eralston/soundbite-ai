    "@soundbite/api": "^1.0.0",
    "@soundbite/api-axios": "^1.0.0",
    "@soundbite/widgets-api": "^1.0.0",
    "@soundbite/widgets-react": "^1.0.0",
    "mobx": "^6.3.2",
    "mobx-react-lite": "^3.2.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-progress-button": "^5.1.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^4.0.3",
    "react-scrubber": "^2.0.0",
    "reactstrap": "^8.9.0",
    "sanitize-html": "^2.3.3",
    "web-vitals": "^1.1.0"
