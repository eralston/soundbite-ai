// Development settings for localhost only. All other files are flavors of "production" settings
{
  "ConnectionStrings": {
    "SbDb": "Server=(localdb)\\MSSQLLocalDB; Database=Soundbite; Trusted_Connection=True;",
    "SbStorage": "[SB STORAGE CONNECTION STRING]"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "soundbite.ai",
    "TenantId": "common",
    "ClientId": "[AAD CLIENT ID]",
    "ClientSecret": "[AAD CLIENT SECRET]"
  },
  "SendGridSettings": {
    "ApiKey": "[SENDGRID API KEY]"
  },
  "TwilioSettings": {
    "AccountSID": "[TWILIO ACCOUNT SID]",
    "AuthToken": "[TWILIO ACCOUNT AUTH TOKEN]",
    "PhoneNumber": "[TWILIO PHONE NUMBER]"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DefaultTokenServiceConfig": {
    "Level": 0,
    "SecurityType": 10,
    "Config": "[DEFAULT SERVICE TOKEN CONFIG]",
    "TokenTimeoutInMinutes": 1440,
    "RefreshTokenTimeoutInMinutes": 43200,
    "ClockSkewInSeconds": 10
  },
  "SpaConfig": {
    "TeamsAppClientId": "[TEAMS APP CLIENT ID]",
    "AdClientConfig": {
      "ClientId": "[SPA AAD CLIENT ID]",
      "ApiUri": "https://soundbite.ai.ngrok.io",
      "RedirectUri": "https://spa.soundbite.ai.ngrok.io/public/sso/loginO365",
      "PostLogoutRedirectUri": "https://spa.soundbite.ai.ngrok.io",
      "AdScopes": [
        "https://graph.microsoft.com/email",
        "https://graph.microsoft.com/offline_access",
        "https://graph.microsoft.com/openid",
        "https://graph.microsoft.com/profile",
        "https://graph.microsoft.com/User.Read"
      ],
      "ApiScopes": [
        "api://soundbite.ai.ngrok.io/[AAD CLIENT ID]/Soundbite.User"
      ]
    },
    "FeatureFlags": {
      "DiscoveryEnabled": "true",
      "OrgSettingsEnabled": "true",
      "ReferralEnabled": "true",
      "TeamCreationEnabled": "true",
      "TeamsEnabled": "true"
    }
  },
  "TeamsAppAzureSettings": {
    "ClientId": "[TEAMS APP CLIENT ID]",
    "SecretKey": "[TEAMS APP CLIENT SECRET]",
    "BaseUrl": "[TEAMS APP BASE URL]"
  },
  "AzureCommunicationServiceSettings": {
    "ConnectionString": "[ACS CONNECTION STRING]",
    "FromEmail": "[ACS FROM EMAIL]",
    "FromName": "Soundbite.AI (Test)"
  },
  "OpenAiSettings": {
    "ApiKey": "[OPEN AI API KEY]",
    "Deployment": "[OPEN AI DEPLOYMENT]",
    "Endpoint": "[OPEN AI ENDPOINT]",
    "Region": "southcentralus"
  },
  "AllowedHosts": "*"
}
