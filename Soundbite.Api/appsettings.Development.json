// Development settings for localhost only. All other files are flavors of "production" settings
{
  "ConnectionStrings": {
    "SbDb": "Server=(localdb)\\MSSQLLocalDB; Database=Soundbite; Trusted_Connection=True;",
    "SbStorage": "[SB STORAGE CONNECTION STRING]"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "soundbite.ai",
    "TenantId": "common",
    "ClientId": "[CLIENT ID]",
    "ClientSecret": "[CLIENT SECRET]"
  },
  "SendGridSettings": {
    "ApiKey": "[SENDGRID API KEY]"
  },
  "TwilioSettings": {
    "AccountSID": "[TWILIO ACCOUNT SID]",
    "AuthToken": "[TWILIO ACCOUNT AUTH TOKEN]",
    "PhoneNumber": "[TWILIO PHONE NUMBER]"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DefaultTokenServiceConfig": {
    "Level": 0,
    "SecurityType": 10,
    "Config": "[DEFAULT SERVICE TOKEN CONFIG]",
    "TokenTimeoutInMinutes": 1440,
    "RefreshTokenTimeoutInMinutes": 43200,
    "ClockSkewInSeconds": 10
  },
  "SpaConfig": {
    "AdClientConfig": {
      "ClientId": "[SPA CONFIG CLIENT ID]",
      "ApiUri": "https://localhost:44390",
      "RedirectUri": "https://localhost:3000/public/sso/loginO365",
      "PostLogoutRedirectUri": "https://localhost:3000",
      "AdScopes": [
        "https://graph.microsoft.com/email",
        "https://graph.microsoft.com/offline_access",
        "https://graph.microsoft.com/openid",
        "https://graph.microsoft.com/profile",
        "https://graph.microsoft.com/User.Read"
      ],
      "ApiScopes": [
        "api://soundbite.ai.ngrok.io/[CLIENT ID]/Soundbite.User"
      ]
    },
    "FeatureFlags": {
      "DiscoveryEnabled": "true",
      "OrgSettingsEnabled": "true",
      "ReferralEnabled": "true",
      "TeamCreationEnabled": "true",
      "TeamsEnabled": "true"
    },
    "TelemetryKey": "[APP INSIGHTS CONN STRING]"
  },
  "TeamsAppAzureSettings": {
    "ClientId": "[TEAMS APP API KEY]",
    "SecretKey": "[TEAMS APP SECRET]",
    "BaseUrl": "[TEAMS APP BASE URL]"
  },
  "AzureTranscriptionSettings": {
    "Region": "westus",
    "Key": "[AZURE TRANSCRIPTION KEY]"
  },
  "AzureMediaServiceSettings": {
    "TenantId": "[AMS TENANT ID]",
    "SubscriptionId": "[AMS SUB ID]",
    "ResourceGroupName": "[AMS RESOURCE GROUP NAME]",
    "MediaServiceAccountName": "[AMS MEIDA ACCOUNT NAME]",
    "DefaultResourceGroupName": "[AMS RESOURCE GROUP NAME]",
    "DefaultPrimaryStorageAccountId": "/subscriptions/[AMS SUB ID]/resourceGroups/[AMS RESOURCE GROUP NAME]/providers/Microsoft.Storage/storageAccounts/sbdeverik",
    "DefaultPrimaryStorageAccountLocation": "West US",
    "MediaTokenIssuer": "<ValueOverriddenInCode>",
    "MediaTokenAudience":"sbuser"
  },
  "AzureCommunicationServiceSettings": {
    "ConnectionString": "[ACS CONNECTION STRING]",
    "FromEmail": "[ACS FROM EMAIL]",
    "FromName": "Soundbite.AI (Test)"
  },
  "OpenAiSettings": {
    "ApiKey": "[OPEN AI API KEY]",
    "Deployment": "[OPEN AI DEPLOYMENT]",
    "Endpoint": "[OPEN AI ENDPOINT]",
    "Region": "southcentralus"
  },
  "AllowedHosts": "*"
}
