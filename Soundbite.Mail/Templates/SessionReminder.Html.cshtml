@using Soundbite
@model SessionModel


@{
    Layout = "_ExternalLayout.Html";
    string sessionTypeName = Enum.GetName(typeof(SessionType), Model.Session.SessionType);
}

<tr>
    <td align="left" style="font-size:0px;padding:10px 25px;word-break:break-word;">
        <div style="font-family:Nunito Sans, helvetica, sans-serif;font-size:16px;line-height:1.5;text-align:left;color:#3f5a78;">
            @sessionTypeName:&nbsp;@Model.Session.Name in the organization @Model.Org.Name needs your recording on <a href="https://soundbite.ai">Soundbite.AI</a>.
        </div>
    </td>
</tr>
@if (Model.IsMsTeamsEnabled)
{
    <tr>
        <td align="center" vertical-align="middle" style="font-size:0px;padding:10px 25px;word-break:break-word;">
            <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate;line-height:100%;">
                <tr>
                    <td align="center" bgcolor="#0081d4" role="presentation" style="border:none;border-radius:3px;cursor:auto;mso-padding-alt:10px 25px;background:#0081d4;" valign="middle">
                        <a href="@Model.MsTeamsActionLink" style="display:inline-block;background:#0081d4;color:#ffffff;font-family:Nunito Sans, helvetica, sans-serif;font-size:16px;font-weight:normal;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:10px 25px;mso-padding-alt:0px;border-radius:3px;"
                       target="_blank">
                            Contribute to <span style="font-weight: bold">@Model.Session.Name</span> in Soundbite for Microsoft Teams
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td align="center" vertical-align="middle" style="font-size:0px;padding:10px 25px;word-break:break-word;">
            <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate;line-height:100%;">
                <tr>
                    <td align="center" role="presentation" style="border:none;border-radius:3px;cursor:auto;mso-padding-alt:10px 25px;" valign="middle">
                        <a href="@Environment.GetEnvironmentVariable("SB_HOME_URL")/organizations/@Model.Org.Route/feed#sbrecord=@Model.Session.Route" style="display:inline-block;color:#0081d4;font-family:Nunito Sans, helvetica, sans-serif;font-size:16px;font-weight:normal;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:10px 25px;mso-padding-alt:0px;border-radius:3px;"
                       target="_blank">
                            Contribute in Soundbite Studio
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
}
else
{
    <tr>
        <td align="center" vertical-align="middle" style="font-size:0px;padding:10px 25px;word-break:break-word;">
            <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate;line-height:100%;">
                <tr>
                    <td align="center" bgcolor="#0081d4" role="presentation" style="border:none;border-radius:3px;cursor:auto;mso-padding-alt:10px 25px;background:#0081d4;" valign="middle">
                        <a href="@Environment.GetEnvironmentVariable("SB_HOME_URL")/organizations/@Model.Org.Route/feed#sbrecord=@Model.Session.Route" style="display:inline-block;background:#0081d4;color:#ffffff;font-family:Nunito Sans, helvetica, sans-serif;font-size:16px;font-weight:normal;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:10px 25px;mso-padding-alt:0px;border-radius:3px;"
                       target="_blank">
                            Contribute to <span style="font-weight: bold">@Model.Session.Name</span> in Soundbite Studio
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
}
