@using Soundbite
@{
    // The introduction is a block in the e-mail explaining WTF Soundbite is
    bool showIntroduction = true;
    string logoUrl = "https://sbuswallstr.blob.core.windows.net/email/soundbite/logo_transparent.png";
    string primaryColor = "";
}

@if (Model != null)
{
    //If we are sending to a user who has touched the platfor, we don't need to bore them with the intro again
    MessageModel messageModel = Model as MessageModel;
    if (messageModel != null)
    {
        showIntroduction = !(messageModel?.Receiver?.InviteAcceptUtc).HasValue;
        logoUrl = messageModel?.Options?.OrgImageUrl ?? logoUrl;
    }
}

