@model Soundbite.UserInviteModel

@{
    Layout = "_ExternalLayout.Html";
}


@section Preview {
    You're invite to Soundbite.ai - A Better Way to Communicate. You are 60 seconds away from experiencing the first and only platfrom for audio on your schedule.
}

<tr>
    <td align="left" style="font-size:0px;padding:10px 25px;word-break:break-word;">
        <div style="font-family:Nunito Sans, helvetica, sans-serif;font-size:16px;line-height:1.5;text-align:left;color:#3f5a78;">
            Hello,
        </div>
    </td>
</tr>
<tr>
    <td align="left" style="font-size:0px;padding:10px 25px;word-break:break-word;">
        <div style="font-family:Nunito Sans, helvetica, sans-serif;font-size:16px;line-height:1.5;text-align:left;color:#3f5a78;">
            I have been using <a href="https://soundbite.ai" target="_blank">Soundbite.ai</a> lately to collaborate with my team, and I love it! So, I would like to share Soundbite.ai with you!
            You can join Soundbite.ai for free by clicking the link and creating an account.
        </div>
    </td>
</tr>
<tr>
    <td align="center" vertical-align="middle" style="font-size:0px;padding:10px 25px;word-break:break-word;">
        <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate;line-height:100%;">
            <tr>
                <td align="center" bgcolor="#0081d4" role="presentation" style="border:none;border-radius:3px;cursor:auto;mso-padding-alt:10px 25px;background:#0081d4;" valign="middle">
                    <a href="@Environment.GetEnvironmentVariable("SB_HOME_URL")" style="display:inline-block;background:#0081d4;color:#ffffff;font-family:Nunito Sans, helvetica, sans-serif;font-size:16px;font-weight:normal;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:10px 25px;mso-padding-alt:0px;border-radius:3px;"
                       target="_blank">
                        Go to Soundbite.ai
                    </a>
                </td>
            </tr>
        </table>
    </td>
</tr>
