[req]
default_bits = 4096
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[ dn ]
C=US
ST=Texas
L=Dallas
O=Soundbite
OU=Development
CN=SoundbiteDev

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = soundbitedev
DNS.2 = localhost
DNS.3 = *.soundbitedev.com