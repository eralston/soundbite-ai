{
  "ConnectionStrings": {
    "SbDb": "", // Release uses Key Vault
    "SbStorage": "" // Release uses Key Vault
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "soundbite.ai",
    "TenantId": "common",
    "ClientId": "[AAD CLIENT ID]",
    "ClientSecret": "[AAD CLIENT SECRET]" // TODO: Migrate to certificate in Key Vault
  },
  "SendGridSettings": {
    "ApiKey": "[SENDGRID API KEY]"
  },
  "TwilioSettings": {
    "AccountSID": "[TWILIO ACCOUNT SID]",
    "AuthToken": "[TWILIO ACCOUNT AUTH TOKEN]",
    "PhoneNumber": "[TWILIO PHONE NUMBER]"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DefaultTokenServiceConfig": {
    "Level": 0,
    "SecurityType": 10,
    "Config": "[TOKEN SERVICE CONFIG]",
    "TokenTimeoutInMinutes": 1440,
    "RefreshTokenTimeoutInMinutes": 43200,
    "ClockSkewInSeconds": 10
  },
  "SpaConfig": {
    "TeamsAppClientId": "[TEAMS APP CLIENT ID]",
    "AdClientConfig": {
      "ClientId": "[SPA CLIENT ID]",
      "ApiUri": "/api",
      "RedirectUri": "https://preview.soundbite.cloud/public/sso/loginO365",
      "PostLogoutRedirectUri": "https://preview.soundbite.cloud",
      "AdScopes": [
        "https://graph.microsoft.com/email",
        "https://graph.microsoft.com/offline_access",
        "https://graph.microsoft.com/openid",
        "https://graph.microsoft.com/profile",
        "https://graph.microsoft.com/User.Read"
      ],
      "ApiScopes": [
        "api://preview.soundbite.cloud/[AAD CLIENT ID]/Soundbite.User"
      ]
    },
    "FeatureFlags": {
      "DiscoveryEnabled": "true",
      "OrgSettingsEnabled": "true",
      "ReferralEnabled": "true",
      "TeamCreationEnabled": "true",
      "TeamsEnabled": "true"
    },
    "TelemetryKey": "[SPA TELEMETRY KEY]"
  },
  "TeamsAppAzureSettings": {
    "ClientId": "[TEAMS APP CLIENT ID]",
    "SecretKey": "[TEAMS APP CLIENT SECRET]",
    "BaseUrl": "[TEAMS APP BASE URL]"
  },
  "AzureTranscriptionSettings": {
    "Region": "westus",
    "Key": "[AZURE TRANSCRIPTION KEY]"
  },
  "AzureMediaServiceSettings": {
    "TenantId": "[AMS TENANT ID]",
    "SubscriptionId": "[AMS SUB ID]",
    "ResourceGroupName": "[AMS RESOURCE GROUP NAME]",
    "MediaServiceAccountName": "sbuswprvmedia",
    "DefaultResourceGroupName": "[AMS RESOURCE GROUP NAME]",
    "DefaultPrimaryStorageAccountId": "/subscriptions/[AMS SUB ID]/resourceGroups/[AMS RESOURCE GROUP NAME]/providers/Microsoft.Storage/storageAccounts/sbuswprvstr",                                      
    "DefaultPrimaryStorageAccountLocation": "West US",
    "ClientId": "[AAD CLIENT ID]",
    "ClientSecret": "[AAD CLIENT SECRET]",
    "MediaTokenIssuer": "<ValueOverriddenInCode>",
    "MediaTokenAudience": "sbuser"
  },
  "AzureCommunicationServiceSettings": {
    "ConnectionString": "[ACS CONNECTION STRING]",
    "FromEmail": "[ACS FROM EMAIL]",
    "FromName": "Soundbite.AI (Preview)"
  },
  "OpenAiSettings": {
    "ApiKey": "[OPEN AI API KEY]",
    "Deployment": "[OPEN AI API DEPLOYMENT]",
    "Endpoint": "[OPEN AI API ENDPOINT]",
    "Region": "southcentralus"
  },
  "AllowedHosts": "*"
}